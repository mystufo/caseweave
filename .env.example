# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider 二选一: anthropic | openai
#   anthropic: 官方 Anthropic API
#   openai:    OpenAI 兼容协议（火山方舟 / DeepSeek / 阿里百炼 / OpenRouter 等）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6
LLM_API_KEY=sk-ant-...
# 自定义 base_url，留空则使用各 provider 官方默认地址
LLM_BASE_URL=

LLM_TIMEOUT_SECONDS=120 # 单次请求超时（秒）；思考型模型跑长文档慢，正常调用被打断就调大
LLM_MAX_RETRIES=1 # 失败重试次数（总耗时上限 ≈ timeout×(1+retries)）

# 示例 1: 火山方舟
# LLM_PROVIDER=openai
# LLM_MODEL=ep-20240xxx-xxxxx          # 接入点 ID 或模型名（如 doubao-pro-32k）
# LLM_API_KEY=your-volces-api-key
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 示例 2: DeepSeek
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1

GENERATOR_MAX_TOKENS=16384 # 生成用例时的最大token数
CLARIFIER_MAX_TOKENS=8192 # 澄清问题时的最大token数
KNOWLEDGE_MAX_TOKENS=8192 # 知识抽取时的最大token数

# 调试用：设置目录后每次 LLM 调用把完整 prompt+响应 dump 成 .txt（支持 ~），留空=关闭
# PROMPT_DUMP_DIR=~/tmp/caseweave_prompts

# ── Embedding 配置──────────────────────────────────────────
# 把知识条目向量化后存入 pgvector 做语义检索。三种模式：
#   1) local（默认，零配置）：用随 docker-compose 起的本地 TEI 容器（BAAI/bge-m3，1024 维，
#      中文友好）。无需 key，走内网 http://embedding:80/v1。首次启动下载 ~2GB 权重（仅一次）。
#   2) openai（远程兼容接口，含 OpenAI / 火山方舟 / 智谱等）：设 EMBEDDING_PROVIDER=openai，
#      填 API_KEY / BASE_URL / MODEL / DIM（维度须与模型一致，如 OpenAI small=1536）。
#   3) 关闭（静默降级）：设 openai 但不填 API_KEY → 写入跳过 embedding、检索退化按时间倒序，不阻塞。
# 注：非 Docker 本地开发（make dev-backend）连不到 compose 内网，会自动降级；需语义检索时可单独起
# TEI（Apple Silicon 用镜像 ...:cpu-arm64-1.9），再把 EMBEDDING_BASE_URL 指到它的 /v1。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 向量维度，必须与 model 实际输出维度一致（不一致会导致知识表被自动重建）。bge-m3=1024
EMBEDDING_DIM=1024
# standard | multimodal（火山方舟视觉版走 /embeddings/multimodal 接口）
EMBEDDING_MODE=standard
# 本地 TEI 镜像架构覆盖：默认 x86 的 cpu-1.9；ARM/Apple Silicon 服务器改为 cpu-arm64-1.9
# EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9

# ── Rerank（精排，检索第二阶段）─────────────────────────────
# 单向量召回负责"捞得全"，精排把 query 与每条候选一起判定相关性负责"排得准"，
# 修好"整篇文档 query vs 单句知识"的相关度不对称问题。全程 fail-open：
# 开关关 / 未配置 / 服务未就绪 / 出错 → 自动降级回纯向量检索（按 KNOWLEDGE_DISTANCE_THRESHOLD 过滤），不阻塞。
#   llm（默认，零部署）：复用主 LLM（LLM_* 那套凭证）一次调用给候选打分，不需新服务/新鉴权；
#                        准确性略逊 cross-encoder，但契合"模型都走远程"的部署。
#   local：随 docker-compose 起的本地 TEI cross-encoder 容器（BAAI/bge-reranker-v2-m3），走内网
#          http://reranker:80，无需 key，首次启动下载 ~2GB 权重。需 docker compose up -d reranker。
#   openai：远程兼容 /rerank 接口（TEI 格式），设 RERANK_PROVIDER=openai + RERANK_API_KEY / BASE_URL / MODEL。
#          注：火山方舟 Ark(/api/v3) 无 rerank 接入点，其 rerank 在 VikingDB(另需 AK/SK)，此项不适用。
RERANK_ENABLED=true
RERANK_PROVIDER=llm
RERANK_MODEL=bge-reranker-v2-m3
RERANK_API_KEY=
RERANK_BASE_URL=
# 召回池大小：喂给精排的候选条数（放宽召回宁多勿漏，再由精排排序取前 TOP_K）
RERANK_CANDIDATE_K=30
# 精排分数下限：保留 score≥该值的条目（score∈[0,1]，越大越相关）。设为 0 或负数 → 不过滤
RERANK_SCORE_THRESHOLD=0.3
# 知识检索 query 分块窗口（配合 max-sim 召回，避免长文平均向量稀释单句相关度）
KNOWLEDGE_QUERY_CHUNK_SIZE=256
KNOWLEDGE_QUERY_CHUNK_OVERLAP=48
# 仅 RERANK_PROVIDER=local 时用：本地 TEI reranker 镜像架构覆盖（ARM/Apple Silicon 改为 cpu-arm64-1.9）
# RERANK_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-arm64-1.9

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL 连接串（须带 +asyncpg 驱动）。Docker 部署 host 用服务名 db，本地用 localhost。
# 默认账号密码 caseweave/caseweave 仅供开发；生产务必改成强密码，并同步 docker-compose.yml 的 POSTGRES_* 。
DATABASE_URL=postgresql+asyncpg://caseweave:caseweave@db:5432/caseweave
# db 容器映射到宿主机的端口，默认 5433 以避开本机已装的 PostgreSQL(5432)。
# 只影响从宿主机/外部连库；容器间通信始终走内网 db:5432，不受此影响。
DB_HOST_PORT=5433

# ── Knowledge ─────────────────────────────────────────────
# 全局生效（所有项目共用）。要按项目精细化配置请等待后续 ProjectSetting 升级。
# 预览面板候选条数：上传后/生成前给前端 KnowledgePreviewPanel 显示多少条候选
KNOWLEDGE_PREVIEW_TOP_K=8
# 自动注入到 LLM prompt 的条数（前端没勾选时走这个 fallback；勾选了走用户选的 ids）
KNOWLEDGE_INJECT_TOP_K=8
# 余弦距离上限：>该值的命中会被丢弃。0.45 ≈ "相关度 ≥ 55%"。设为 0 或负数 → 不过滤
# 注：RERANK_ENABLED=true 时命中过滤改由 RERANK_SCORE_THRESHOLD 主导，本项仅在精排降级路径生效。
KNOWLEDGE_DISTANCE_THRESHOLD=0.45
# summarize_for_prompt 拼接到 prompt 的最大字符数（防 prompt 撑爆上下文）
KNOWLEDGE_PROMPT_MAX_CHARS=1800

# ── Prompt 改进建议 ────────────────────────────────────────
# 定期后台任务只生成 pending 草稿、绝不激活；采用仍靠人工走版本化 API。
# interval ≤ 0 关闭后台巡检（仅保留网页端手动按钮）。
PROMPT_SUGGESTION_INTERVAL_HOURS=24
# 少于该条负反馈样本就不给建议（信号太弱）。手动 / 后台共用。
PROMPT_SUGGESTION_MIN_SAMPLES=3

# ── 飞书文档导入（可选，用到 Lark 文档 URL 导入功能才需要）─────────────────────
# lark-cli 可执行文件路径（需另行安装）；不使用飞书导入可忽略以下全部。
LARK_CLI_PATH=lark-cli
LARK_CLI_TIMEOUT_SECONDS=60
# 抓取身份：user（个人授权，配合 lark-cli auth login）| bot（应用身份，需 app_id/secret）。
# 默认 bot：凭证不过期、不依赖 OS keychain，适合容器/服务器部署。
LARK_CLI_IDENTITY=bot
# bot 应用凭证，在飞书开放平台「凭证与基础信息」获取；应用需开通 docx:document:readonly 等权限并发布，
# 且把目标文档/知识库共享给该应用。容器启动脚本会用这两值自动 config init（secret 存容器级 keychain，
# 容器重建即失效，故须每次启动重新注入）。
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=
# Docker 部署专用：需把宿主机的 Node 运行时和 lark-cli 凭证挂进 backend 容器（经 docker-compose）。
# LARK_NODE_DIR：宿主机 nvm 里装了 @larksuite/cli 的那个 node 版本目录（which lark-cli 反查 → .../node/vX.Y.Z）。
# LARK_CLI_HOME：lark-cli 凭证目录，一般是 ~/.lark-cli。
LARK_NODE_DIR=/root/.nvm/versions/node/v24.14.0
LARK_CLI_HOME=/root/.lark-cli
# 文档内嵌画板（流程图/状态图/思维导图）→ 文字：走 lark-cli `whiteboard +query` 直接取
# Mermaid 源码或节点+连线结构，纯文本、不消耗 LLM token，因此默认开启、与 VISION 无关。
# 结构化提取不到内容时，若 VISION_ENABLED=true 会再退回「画板缩略图 + 视觉识别」。
LARK_WHITEBOARD_ENABLED=true
LARK_WHITEBOARD_MAX_CHARS=4000             # 单个画板注入正文的字数上限

# ── 视觉模型（图片 → 文字，可选）───────────────────────────────────────────────
VISION_ENABLED=false # 是否开启飞书文档解析图片功能，开启但是下方内容不配置时会自动回退到主模型
# 火山方舟 doubao-vision 示例（provider 用 openai 兼容协议）：
# VISION_PROVIDER=openai
# VISION_MODEL=ep-visionxxxxxxxx          # 视觉模型接入点 ID（如 doubao-1.5-vision-pro）
# VISION_API_KEY=your-volces-api-key
# VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MAX_TOKENS=4096
VISION_MAX_IMAGES=20                       # 单文档识别图片张数上限
VISION_CONCURRENCY=3                       # 图片识别并发数

# ── LangSmith (可选，仅用于调试 Prompt/追踪 LLM 调用) ──────────────────────────
# 想在 LangSmith 看调用链路时才需要：置 true 并填 API_KEY；不用可保持 false。
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=caseweave

# ── Browser Agent (Phase 5，未启用) ───────────────────────────────────────────
# 被测产品地址与登录凭证，供后续 Playwright 自动探索用；当前阶段留空即可。
PRODUCT_URL=
PRODUCT_CREDENTIALS=

# ── Zentao MCP (Phase 6，未启用) ─────────────────────────────────────────────
# 禅道 MCP 端点，供后续 Bug 分析 / 回归用例生成用；当前阶段留空即可。
ZENTAO_MCP_ENDPOINT=

# ── App ───────────────────────────────────────────────────────────────────────
# ⚠️ 生产必改：DEBUG=true 会打开 SQL echo 与更详细日志（可能泄露数据）。上线前务必设为 false。
DEBUG=true
# 允许跨域访问后端的前端来源（逗号分隔）。必须包含前端实际访问地址，否则浏览器拦截请求。
CORS_ORIGINS=http://localhost:3001,http://localhost:5173
# 日志文件路径：非空则日志在打到终端的同时写入该文件（自动轮转，单文件10MB×5份）。
# 支持 ~ 展开；相对路径以后端进程 CWD 为基准。留空则只打到终端（stderr）。默认 logs/app.log。
LOG_FILE=logs/app.log

# ── Auth ──────────────────────────────────────────────────────────────────────
# 管理员邮箱（逗号分隔，大小写不敏感）。仅这些账号能创建/删除项目；普通用户可注册并使用任意项目。
ADMIN_EMAILS=admin@example.com
# ⚠️ 生产必填：用来签发登录 JWT，换成随机值（openssl rand -hex 32）。
#    留空或保留占位值 dev-secret-change-me 时，后端启动会生成【进程内随机密钥】并打警告——
#    功能可用但重启即掉登录态，且多 worker 部署下登录直接不可用。
JWT_SECRET=
JWT_ALGORITHM=HS256
# Token 有效期（小时），默认 168 = 7 天
JWT_EXPIRE_HOURS=168

