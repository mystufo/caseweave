# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider 二选一: anthropic | openai
#   anthropic: 官方 Anthropic API
#   openai:    OpenAI 兼容协议（火山方舟 / DeepSeek / 阿里百炼 / OpenRouter 等）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-6
LLM_API_KEY=sk-ant-...
# 自定义 base_url，留空则使用各 provider 官方默认地址
LLM_BASE_URL=

# 单次 LLM 调用超时（秒）与失败重试次数。没有超时时 provider 卡住会让请求永久挂起，
# 前端「正在抽取产品知识…」等 loader 就会一直打转。最坏耗时 = 超时 ×(1+重试次数)。
# 思考型模型在长文档上本就慢，若正常调用也被超时打断，就把 LLM_TIMEOUT_SECONDS 调大。
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1

# 示例 1: 火山方舟
# LLM_PROVIDER=openai
# LLM_MODEL=ep-20240xxx-xxxxx          # 接入点 ID 或模型名（如 doubao-pro-32k）
# LLM_API_KEY=your-volces-api-key
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 示例 2: DeepSeek
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=your-deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1

# ── LLM max_tokens 上限（按 agent 拆分） ──────────────────────────────────────
# 三个分开是因为输出体量需求差异很大：
#   GENERATOR_MAX_TOKENS：生成几十条用例的 JSON 数组，最易被截断；同时填 PRD+脑图+
#                         多轮澄清时 16384 仍可能不够，必要时调到 24576 / 32768
#   CLARIFIER_MAX_TOKENS：JSON 问题列表，几 KB 量级，8192 通常足够
#   KNOWLEDGE_MAX_TOKENS：知识抽取条目 JSON 数组，与文档体量相关，8192 一般够
# 注意：思考模型（如 kimi-k2 / o1）的 max_tokens 通常**包含 reasoning_tokens**，
# 给小了会先把思考 token 烧完然后正文为空 —— 不要随便往下调
GENERATOR_MAX_TOKENS=16384
CLARIFIER_MAX_TOKENS=8192
KNOWLEDGE_MAX_TOKENS=8192

# ── 调试：dump 每次 LLM 调用的完整 prompt+响应 ────────────────────────────────
# 设置目录后（支持 ~ 展开），每次 LLM 调用会写一份 .txt 到该目录，
# 内含 SYSTEM / USER / RESPONSE 三段。留空 = 关闭（零开销）
# PROMPT_DUMP_DIR=~/tmp/testcraft_prompts

# ── Embedding (Phase 3 知识语义检索) ──────────────────────────────────────────
# 把知识条目向量化后存入 pgvector 做语义检索。凭证/接口与主 LLM 独立配置。
# 全部留空则静默降级：写入跳过 embedding、检索退化为按时间倒序，不阻塞主流程。
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# 向量维度，必须与上面 model 实际输出维度一致（不一致会导致知识表被重建）
EMBEDDING_DIM=1536
# standard | multimodal（火山方舟视觉版走 /embeddings/multimodal 接口）
EMBEDDING_MODE=standard

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL 连接串（须带 +asyncpg 驱动）。Docker 部署 host 用服务名 db，本地用 localhost。
DATABASE_URL=postgresql+asyncpg://testcraft:testcraft@db:5432/testcraft
# db 容器映射到宿主机的端口，默认 5433 以避开本机已装的 PostgreSQL(5432)。
# 只影响从宿主机/外部连库；容器间通信始终走内网 db:5432，不受此影响。
DB_HOST_PORT=5433

# ── Knowledge retrieval (Phase 3) ─────────────────────────────────────────────
# 全局生效（所有项目共用）。要按项目精细化配置请等待后续 ProjectSetting 升级。
# 预览面板候选条数：上传后/生成前给前端 KnowledgePreviewPanel 显示多少条候选
KNOWLEDGE_PREVIEW_TOP_K=8
# 自动注入到 LLM prompt 的条数（前端没勾选时走这个 fallback；勾选了走用户选的 ids）
KNOWLEDGE_INJECT_TOP_K=8
# 余弦距离上限：>该值的命中会被丢弃。0.45 ≈ "相关度 ≥ 55%"。设为 0 或负数 → 不过滤
KNOWLEDGE_DISTANCE_THRESHOLD=0.45
# summarize_for_prompt 拼接到 prompt 的最大字符数（防 prompt 撑爆上下文）
KNOWLEDGE_PROMPT_MAX_CHARS=1800

# ── Prompt 改进建议（Phase 4.2 二阶段）────────────────────────────────────────
# 定期后台任务只生成 pending 草稿、绝不激活；采用仍靠人工走版本化 API。
# interval ≤ 0 关闭后台巡检（仅保留网页端手动按钮）。
PROMPT_SUGGESTION_INTERVAL_HOURS=24
# 少于该条负反馈样本就不给建议（信号太弱）。手动 / 后台共用。
PROMPT_SUGGESTION_MIN_SAMPLES=3

# ── 飞书文档导入（可选，用到 Lark 文档 URL 导入功能才需要）─────────────────────
# lark-cli 可执行文件路径（需另行安装）；不使用飞书导入可忽略。
LARK_CLI_PATH=lark-cli
LARK_CLI_TIMEOUT_SECONDS=60
# Docker 部署专用：后端在容器里，需挂载宿主机的 Node 运行时和 lark-cli 登录凭证才能用飞书导入。
# LARK_NODE_DIR：宿主机 nvm 里装了 @larksuite/cli 的那个 node 版本目录（which lark-cli 反查 → 取到 .../node/vX.Y.Z）。
# LARK_CLI_HOME：lark-cli 凭证目录，一般是 ~/.lark-cli。两者均通过 docker-compose 挂进 backend 容器。
LARK_NODE_DIR=/root/.nvm/versions/node/v24.14.0
LARK_CLI_HOME=/root/.lark-cli

# ── LangSmith (可选，仅用于调试 Prompt/追踪 LLM 调用) ──────────────────────────
# 想在 LangSmith 看调用链路时才需要：置 true 并填 API_KEY；不用可保持 false。
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=testcraft-ai

# ── Browser Agent (Phase 5，未启用) ───────────────────────────────────────────
# 被测产品地址与登录凭证，供后续 Playwright 自动探索用；当前阶段留空即可。
PRODUCT_URL=
PRODUCT_CREDENTIALS=

# ── Zentao MCP (Phase 6，未启用) ─────────────────────────────────────────────
# 禅道 MCP 端点，供后续 Bug 分析 / 回归用例生成用；当前阶段留空即可。
ZENTAO_MCP_ENDPOINT=

# ── App ───────────────────────────────────────────────────────────────────────
# DEBUG=true 会打开 SQL echo 与更详细日志，生产请保持 false。
DEBUG=false
# 允许跨域访问后端的前端来源（逗号分隔）。必须包含前端实际访问地址，否则浏览器拦截请求。
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────────────
# 管理员邮箱（逗号分隔，大小写不敏感）。仅这些账号能创建/删除项目；普通用户可注册并使用任意项目。
ADMIN_EMAILS=admin@example.com
# 用来签发登录 JWT。生产务必改成随机值（openssl rand -hex 32），用默认值 = 任何人可伪造登录。
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
# Token 有效期（小时），默认 168 = 7 天
JWT_EXPIRE_HOURS=168

